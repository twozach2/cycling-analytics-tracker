# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
*.tsbuildinfo

# generated web builds
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

/dist/
/dist-electron/
/dist-installers/
/.wrangler/

# downloaded BRouter regional data
*.rd5
/outputs/
/work/
/.local-data/

# generated native BRouter bundle (rebuilt per target platform)
/resources/brouter/runtime/
/resources/brouter/profiles2/
/resources/brouter/brouter-server.jar
/resources/brouter/LICENSE-BRouter.txt
/resources/brouter/runtime-manifest.json
